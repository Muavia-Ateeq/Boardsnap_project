# Keep the real value in your hosting provider's secret settings, never in Git.
ROBOFLOW_API_KEY=replace-with-your-roboflow-private-api-key
# Paste the complete workflow inference URL from Roboflow.
ROBOFLOW_WORKFLOW_URL=
# Optional label for the detector shown in logs. The workflow URL selects the actual hosted model.
ROBOFLOW_MODEL_ID=boardsnap-workflow
ROBOFLOW_OCR_WORKFLOW_URL=https://serverless.roboflow.com/moyeon-abrar/workflows/qwen-vl
ALLOW_DEMO_DETECTOR_FALLBACK=false
ALLOW_LOCAL_OCR_FALLBACK=true
TROCR_MODEL_ID=microsoft/trocr-base-handwritten
