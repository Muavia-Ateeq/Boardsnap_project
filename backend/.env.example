PORT=5000
VISION_SERVICE_URL=http://localhost:8000
LLM_SERVICE_URL=http://localhost:8001
VISION_REQUEST_TIMEOUT_MS=300000
LLM_REQUEST_TIMEOUT_MS=60000
PIPELINE_STEP_RETRIES=2
MAX_UPLOAD_BYTES=10485760
MONGODB_DATABASE=boardsnap
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Set this to enable persistent MongoDB storage. Leave unset for local in-memory development.
# MONGODB_URI=mongodb://127.0.0.1:27017/boardsnap
# Set this to a persistent disk path when deploying the API.
# UPLOAD_DIR=./uploads
